# Environment Variables
# Copy this file to .env.local and fill in the values

# Neon Database
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_PROJECT_POOLER_URL/YOUR_DB?sslmode=require

# NVIDIA AI API (OpenAI-compatible)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# JWT Secret for Authentication
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS

# App Configuration
NEXT_PUBLIC_APP_NAME=CelebPlan AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
